{
  "name": "postuler-juste",
  "version": "0.5.0",
  "description": "Recherche d'emploi et de missions pilotée par une IA : tri des offres avec une grille transparente, candidatures et CV honnêtes, suivi. Base SQLite, tableau de bord web, CLI et serveur MCP.",
  "keywords": [
    "recherche-emploi",
    "emploi",
    "candidature",
    "cv",
    "freelance",
    "mcp",
    "claude-code",
    "agent-ia",
    "sqlite",
    "french"
  ],
  "author": "Damien BECHERINI",
  "license": "MIT",
  "homepage": "https://github.com/DamienBecherini/postuler-juste#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DamienBecherini/postuler-juste.git"
  },
  "bugs": {
    "url": "https://github.com/DamienBecherini/postuler-juste/issues"
  },
  "type": "module",
  "bin": {
    "postuler-juste": "bin/postuler-juste.js",
    "cap-emploi": "bin/cap-emploi.js"
  },
  "files": [
    "bin",
    "dist",
    "migrations",
    "modele",
    "modele-en",
    "gabarits",
    "exemples",
    "AGENTS.md",
    "docs/utiliser-avec-une-ia.md",
    "postuler-juste.config.example.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json && tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json",
    "test": "vitest run",
    "dev:ui": "vite",
    "postuler-juste": "node bin/postuler-juste.js",
    "build:js": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "entities": "^7.0.1",
    "hono": "^4.13.16",
    "marked": "^18.1.1",
    "postal-mime": "^2.4.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.67.0",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.4"
  }
}
