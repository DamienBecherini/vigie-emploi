{
  "name": "vigie-emploi",
  "version": "0.6.0",
  "description": "Recherche d'emploi et de missions pilotée par une IA : tri des offres avec une grille transparente, candidatures et CV honnêtes, suivi. Base SQLite, tableau de bord web, CLI et serveur MCP.",
  "keywords": [
    "recherche-emploi",
    "emploi",
    "candidature",
    "cv",
    "freelance",
    "mcp",
    "claude-code",
    "agent-ia",
    "sqlite",
    "french"
  ],
  "author": "Damien BECHERINI",
  "license": "MIT",
  "homepage": "https://github.com/DamienBecherini/vigie-emploi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DamienBecherini/vigie-emploi.git"
  },
  "bugs": {
    "url": "https://github.com/DamienBecherini/vigie-emploi/issues"
  },
  "type": "module",
  "bin": {
    "vigie-emploi": "bin/vigie-emploi.js"
  },
  "files": [
    "bin",
    "dist",
    "migrations",
    "scaffold",
    "scaffold-en",
    "templates",
    "examples",
    "AGENTS.md",
    "AGENTS.*.md",
    "docs/utiliser-avec-une-ia.md",
    "docs/utiliser-avec-une-ia.en.md",
    "vigie-emploi.config.example.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && tsc -p ui/tsconfig.json && tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json",
    "test": "vitest run",
    "dev:ui": "vite",
    "vigie-emploi": "node bin/vigie-emploi.js",
    "build:js": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "mcpb": "node scripts/mcpb.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "entities": "^7.0.1",
    "hono": "^4.13.16",
    "imapflow": "2.10.0",
    "marked": "^18.1.1",
    "postal-mime": "^2.4.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "hoodiecrow-imap": "3.3.1",
    "lucide-react": "^1.67.0",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
