{
  "name": "cap-emploi",
  "version": "0.4.0",
  "private": true,
  "description": "Suivi local des offres d'emploi et de mission : base SQLite, tableau de bord web et CLI pilotable par une IA.",
  "type": "module",
  "bin": {
    "cap-emploi": "bin/cap-emploi.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json",
    "test": "vitest run",
    "dev:ui": "vite",
    "cap-emploi": "node bin/cap-emploi.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "entities": "^7.0.1",
    "hono": "^4.13.16",
    "marked": "^18.1.1",
    "postal-mime": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.4"
  }
}
